<mxfile host="app.diagrams.net">
  <diagram name="OpenClaw Architecture" id="oci-openclaw-arch">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="user-box" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;arcSize=20;" value="&lt;font style=&quot;font-size: 18px;&quot;&gt;&lt;b&gt;User&lt;/b&gt;&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;RDP Client&lt;/font&gt;&lt;/div&gt;">
          <mxGeometry height="70" width="130" x="50" y="175" as="geometry" />
        </mxCell>

        <mxCell id="instance-container" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEFAD6;strokeColor=#CD6C00;fontSize=12;fontStyle=1;verticalAlign=top;arcSize=5;" value="&lt;font style=&quot;font-size: 18px;&quot;&gt;&lt;b&gt;Compute Instance — openclaw-host&lt;/b&gt;&lt;br&gt;Ubuntu 24.04 · VM.Standard.E4.Flex&lt;br&gt;pub-subnet-1 · NSG :3389&lt;/font&gt;">
          <mxGeometry height="560" width="500" x="250" y="110" as="geometry" />
        </mxCell>

        <mxCell id="desktop-box" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=11;arcSize=10;" value="&lt;font style=&quot;font-size: 18px;&quot;&gt;&lt;b&gt;LXQt Desktop&lt;/b&gt; · XRDP&lt;br&gt;Chrome · VS Code · OnlyOffice · Terminal&lt;/font&gt;">
          <mxGeometry height="60" width="430" x="285" y="180" as="geometry" />
        </mxCell>

        <mxCell id="openclaw-box" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;arcSize=10;" value="&lt;font style=&quot;font-size: 18px;&quot;&gt;&lt;b&gt;OpenClaw Gateway&lt;/b&gt; · :18789 &lt;i&gt;(loopback only)&lt;/i&gt;&lt;br&gt;&lt;br&gt;Exec &amp;nbsp;|&amp;nbsp; File System &amp;nbsp;|&amp;nbsp; Browser &amp;nbsp;|&amp;nbsp; Email&lt;/font&gt;">
          <mxGeometry height="85" width="430" x="285" y="280" as="geometry" />
        </mxCell>

        <mxCell id="litellm-box" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;arcSize=10;" value="&lt;font style=&quot;font-size: 18px;&quot;&gt;&lt;b&gt;LiteLLM Proxy&lt;/b&gt; · :4000&lt;br&gt;OpenAI-compatible API in front of OCI Generative AI&lt;/font&gt;">
          <mxGeometry height="75" width="430" x="285" y="405" as="geometry" />
        </mxCell>

        <mxCell id="ocicli-box" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;arcSize=10;" value="&lt;font style=&quot;font-size: 18px;&quot;&gt;&lt;b&gt;OCI CLI&lt;/b&gt; — run by the agent via Exec&lt;br&gt;&lt;i&gt;--auth instance_principal · no key on disk&lt;/i&gt;&lt;/font&gt;">
          <mxGeometry height="70" width="430" x="285" y="525" as="geometry" />
        </mxCell>

        <mxCell id="email-box" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;arcSize=10;" value="&lt;font style=&quot;font-size: 18px;&quot;&gt;&lt;b&gt;OCI Email Delivery&lt;/b&gt;&lt;br&gt;Outbound mail via msmtp · SMTP credentials&lt;/font&gt;">
          <mxGeometry height="70" width="420" x="900" y="150" as="geometry" />
        </mxCell>

        <mxCell id="genai-container" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#d79b00;fontSize=12;arcSize=5;verticalAlign=top;" value="&lt;b&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;OCI Generative AI — us-chicago-1&lt;/font&gt;&lt;/b&gt;">
          <mxGeometry height="250" width="420" x="900" y="280" as="geometry" />
        </mxCell>

        <mxCell id="maverick-box" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0a30a;fontColor=#000000;strokeColor=#BD7000;fontSize=11;arcSize=20;" value="&lt;font style=&quot;font-size: 16px;&quot;&gt;&lt;b&gt;Llama 4 Maverick&lt;/b&gt;&lt;br&gt;&lt;i&gt;primary · tool calling&lt;/i&gt;&lt;/font&gt;">
          <mxGeometry height="60" width="185" x="920" y="340" as="geometry" />
        </mxCell>

        <mxCell id="scout-box" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0a30a;fontColor=#000000;strokeColor=#BD7000;fontSize=11;arcSize=20;" value="&lt;font style=&quot;font-size: 16px;&quot;&gt;&lt;b&gt;Llama 4 Scout&lt;/b&gt;&lt;br&gt;&lt;i&gt;lower latency&lt;/i&gt;&lt;/font&gt;">
          <mxGeometry height="60" width="185" x="1120" y="340" as="geometry" />
        </mxCell>

        <mxCell id="gptoss-box" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0a30a;fontColor=#000000;strokeColor=#BD7000;fontSize=11;arcSize=20;" value="&lt;font style=&quot;font-size: 16px;&quot;&gt;&lt;b&gt;GPT-OSS 120B&lt;/b&gt;&lt;br&gt;&lt;i&gt;open weight · chat&lt;/i&gt;&lt;/font&gt;">
          <mxGeometry height="60" width="185" x="920" y="415" as="geometry" />
        </mxCell>

        <mxCell id="grok-box" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0a30a;fontColor=#000000;strokeColor=#BD7000;fontSize=11;arcSize=20;" value="&lt;font style=&quot;font-size: 16px;&quot;&gt;&lt;b&gt;Grok 4&lt;/b&gt;&lt;br&gt;&lt;i&gt;alternate vendor&lt;/i&gt;&lt;/font&gt;">
          <mxGeometry height="60" width="185" x="1120" y="415" as="geometry" />
        </mxCell>

        <mxCell id="genai-note" parent="1" vertex="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontStyle=2;fontColor=#7A4B00;" value="on demand · pay per token · no dedicated AI cluster">
          <mxGeometry height="25" width="385" x="920" y="488" as="geometry" />
        </mxCell>

        <mxCell id="ociservices-box" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;arcSize=10;" value="&lt;font style=&quot;font-size: 18px;&quot;&gt;&lt;b&gt;OCI Control Plane&lt;/b&gt;&lt;br&gt;Compartment read-only · Usage API&lt;/font&gt;">
          <mxGeometry height="70" width="420" x="900" y="560" as="geometry" />
        </mxCell>

        <mxCell id="identity-note" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=left;verticalAlign=top;arcSize=5;spacing=10;" value="&lt;font style=&quot;font-size: 17px;&quot;&gt;&lt;b&gt;Two identities, deliberately separated&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;openclaw-svc&lt;/b&gt; user + API key — held only by LiteLLM. Its entire grant is &lt;i&gt;use generative-ai-family&lt;/i&gt;. LiteLLM's proxy cannot use an instance principal, so this key exists; it is written to /etc/litellm.env at first boot and never baked into the image.&lt;br&gt;&lt;br&gt;&lt;b&gt;openclaw-dg&lt;/b&gt; dynamic group — the instance principal the agent's OCI CLI uses. It has &lt;b&gt;no&lt;/b&gt; Generative AI access, so the agent cannot bypass the proxy, its master key or its model allowlist.&lt;/font&gt;">
          <mxGeometry height="185" width="1070" x="250" y="700" as="geometry" />
        </mxCell>

        <mxCell id="rdp-arrow" parent="1" edge="1" source="user-box" target="desktop-box" style="edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=13;fontStyle=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" value="RDP :3389">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="browser-arrow" parent="1" edge="1" source="desktop-box" target="openclaw-box" style="edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=13;fontStyle=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=none;" value="localhost:18789">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="litellm-arrow" parent="1" edge="1" source="openclaw-box" target="litellm-box" style="edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=13;fontStyle=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=none;" value="model requests">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="arrow-genai" parent="1" edge="1" source="litellm-box" target="genai-container" style="edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=13;fontStyle=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeWidth=2;strokeColor=#b85450;labelBackgroundColor=#FFFFFF;" value="openclaw-svc API key">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="arrow-ociservices" parent="1" edge="1" source="ocicli-box" target="ociservices-box" style="edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=13;fontStyle=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeWidth=2;strokeColor=#82b366;labelBackgroundColor=#FFFFFF;" value="instance principal">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="arrow-email" parent="1" edge="1" source="openclaw-box" target="email-box" style="edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=13;fontStyle=2;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" value="email">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
